    <listPlace>
      <place xml:id="curia-julia">
        <placeName>Curia Julia</placeName>
        <note type="desc">Das Versammlungshaus des römischen Senats auf dem Forum Romanum.</note>
      </place>
      <place xml:id="chalcidicum">
        <placeName>Chalcidicum</placeName>
        <note type="desc">Ein Vorbau oder eine Säulenhalle, die an die Curia Julia angrenzte.</note>
      </place>
      <place xml:id="temple-apollo">
        <placeName>Apollotempel auf dem Palatin</placeName>
        <note type="desc">Ein prächtiger Tempel zu Ehren Apollos, direkt neben dem Haus des Augustus.</note>
      </place>
      <place xml:id="palatium">
        <placeName>Palatin</placeName>
        <note type="desc">Einer der sieben Hügel Roms, Wohnort der Kaiser.</note>
      </place>
      <place xml:id="temple-caesar">
        <placeName>Tempel des Divus Iulius</placeName>
        <note type="desc">Tempel für den vergöttlichten Gaius Iulius Caesar auf dem Forum Romanum.</note>
      </place>
      <place xml:id="lupercal">
        <placeName>Lupercal</placeName>
        <note type="desc">Die heilige Höhle am Fuße des Palatins, in der die Wölfin Romulus und Remus gesäugt haben soll.</note>
      </place>
      <place xml:id="porticus-octavia">
        <placeName>Porticus Octavia</placeName>
        <note type="desc">Eine Säulenhalle in der Nähe des Circus Flaminius, benannt nach Octavia, der Schwester des Augustus.</note>
      </place>
      <place xml:id="circus-flaminius">
        <placeName>Circus Flaminius</placeName>
        <note type="desc">Ein Platz für Spiele und Versammlungen auf dem Marsfeld.</note>
      </place>
      <place xml:id="pulvinaria">
        <placeName>Pulvinar</placeName>
        <note type="desc">Eine Ehrenloge oder Weihestätte für die Götterbilder bei den Spielen.</note>
      </place>
      <place xml:id="circus-maximus">
        <placeName>Circus Maximus</placeName>
        <note type="desc">Die größte Wagenrennbahn im antiken Rom.</note>
      </place>
      <place xml:id="capitolium">
        <placeName>Kapitol</placeName>
        <note type="desc">Der wichtigste Hügel Roms mit dem Tempel des Jupiter Optimus Maximus.</note>
      </place>
      <place xml:id="temple-jupiter-feretrius">
        <placeName>Tempel des Juppiter Feretrius</placeName>
        <note type="desc">Einer der ältesten Tempel Roms auf dem Kapitol.</note>
      </place>
      <place xml:id="temple-jupiter-tonans">
        <placeName>Tempel des Juppiter Tonans</placeName>
        <note type="desc">Tempel für den "donnernden Juppiter" auf dem Kapitol.</note>
      </place>
      <place xml:id="temple-quirinus">
        <placeName>Tempel des Quirinus</placeName>
        <note type="desc">Tempel für die altitalische Gottheit Quirinus auf dem Quirinal.</note>
      </place>
      <place xml:id="temple-minerva">
        <placeName>Tempel der Minerva</placeName>
        <note type="desc">Heiligtum der Göttin Minerva auf dem Aventin.</note>
      </place>
      <place xml:id="temple-juno-regina">
        <placeName>Tempel der Juno Regina</placeName>
